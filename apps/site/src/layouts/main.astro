---
import "@/styles/global.css"
import AdSlot from "@/components/site/AdSlot.astro"
import { Breadcrumbs } from "@/components/site/Breadcrumbs"
import { type Crumb, type JsonLd, breadcrumbList } from "@/lib/jsonld"
import { ogImage } from "@/lib/og"
import { SITE, absoluteUrl, categories, pages, paths } from "@/lib/site"
import { formatDate, isoDate, text } from "@/lib/ui-text"

interface Props {
  title: string
  description: string
  /** Open Graph 图的绝对地址，默认是站点图。 */
  image?: string
  ogType?: "website" | "article"
  /** 面包屑，不含首页；首页本身不传。 */
  crumbs?: Crumb[]
  jsonLd?: JsonLd[]
  updated: Date
}

const { title, description, ogType = "website", crumbs, jsonLd = [], updated } = Astro.props
const path = Astro.url.pathname
const canonical = absoluteUrl(path)
const image = Astro.props.image ?? (await ogImage())
const fullCrumbs = crumbs && [{ name: text.home, path: paths.home }, ...crumbs]
const structuredData = fullCrumbs ? [...jsonLd, breadcrumbList(fullCrumbs)] : jsonLd
---

<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="text/markdown" href={paths.markdown(path)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    {structuredData.map((data) => <script is:inline type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, "\\u003c")} />)}
  </head>
  <body class="flex min-h-dvh flex-col">
    <header class="border-b">
      <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-3 sm:px-6">
        <a href={paths.home} class="font-heading font-semibold">{SITE.name}</a>
        {
          categories.length > 0 && (
            <nav aria-label={text.mainNav}>
              <ul class="flex flex-wrap gap-4 text-sm">
                {categories.map((category) => (
                  <li>
                    <a
                      href={paths.category(category.id)}
                      class="text-muted-foreground transition-colors hover:text-foreground aria-[current=page]:text-foreground"
                      aria-current={path === paths.category(category.id) ? "page" : undefined}
                    >
                      {text.gamesInCategory(category.name)}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
      </div>
    </header>

    <AdSlot name="top" />

    <main class="mx-auto flex w-full max-w-5xl flex-1 flex-col gap-8 px-4 py-6 sm:px-6">
      {fullCrumbs && <Breadcrumbs crumbs={fullCrumbs} />}
      <slot />
      <p class="text-sm text-muted-foreground">
        {text.lastUpdated}: <time datetime={isoDate(updated)}>{formatDate(updated)}</time>
      </p>
    </main>

    <AdSlot name="bottom" />

    <footer class="border-t">
      <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-4 px-4 py-6 text-sm text-muted-foreground sm:px-6">
        <span>{SITE.name}</span>
        <ul class="flex flex-wrap gap-4">
          {
            pages.map((page) => (
              <li>
                <a href={paths.page(page.slug)} class="transition-colors hover:text-foreground">
                  {page.title}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </footer>
  </body>
</html>
