---
import { render } from "astro:content"
import Layout from "@/layouts/main.astro"
import { type Page, pages, paths } from "@/lib/site"

export function getStaticPaths() {
  return pages.map((page) => ({ params: { page: page.slug }, props: { page } }))
}

interface Props {
  page: Page
}

const { page } = Astro.props
const { Content } = await render(page.entry)
---

<Layout
  title={page.title}
  description={page.description}
  crumbs={[{ name: page.title, path: paths.page(page.slug) }]}
  updated={page.updated}
>
  <article class="typeset max-w-3xl">
    <h1>{page.title}</h1>
    <Content />
  </article>
</Layout>
